   "text": "BATTLE IN CITY STREETS\nLights Put Out in Laurel, Delaware,\nWhile Blacks Continue\nTheir Attack.",
   "status": "ok",
   "confidence": 0.5789868831634521,
   "lines": [],
   "bbox_ocr": {
